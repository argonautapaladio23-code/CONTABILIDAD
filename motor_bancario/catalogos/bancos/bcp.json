{
  "banco": "Banco de Crédito del Perú (BCP)",
  "codigo": "BCP",
  "activado": true,
  "identificacion": {
    "$comentario": "VERIFICAR contra PDF real de BCP. Patrones típicos: 'Banco de Crédito del Perú', logo textual 'BCP', 'Cuenta N°'.",
    "patrones_detect": [
      "(?i)bcp",
      "(?i)banco\\s+de\\s+cr[eé]dito"
    ],
    "cuenta": {
      "$comentario": "VERIFICAR: BCP imprime 'CUENTA N°' con formato 191-XXXXXX-0-XXX o 91-... según producto (ahorros/corriente).",
      "regex": "cuenta[^0-9]{0,45}([0-9][0-9 .\\-]{6,20}[0-9])",
      "grupo": 1
    },
    "cci": {
      "regex": "(?:cci)\\s*[:.]?\\s*([0-9]{4}[\\s-]?[0-9]{4}[\\s-]?[0-9]{6}[\\s-]?[0-9])",
      "grupo": 1,
      "opcional": true
    },
    "periodo": {
      "$comentario": "VERIFICAR: BCP suele usar 'DEL 01/07/2026 AL 31/07/2026' o encabezado 'MES: JULIO 2026'.",
      "patrones": [
        {
          "regex": "del\\s+([0-9]{2}/[0-9]{2}/[0-9]{4})\\s+al\\s+([0-9]{2}/[0-9]{2}/[0-9]{4})",
          "tipo": "rango_fecha"
        },
        {
          "regex": "(?:mes|per[ií]odo)\\s*[:.]?\\s*([0-9]{1,2}|enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)[^0-9a-zñ]+(20[0-9]{2})",
          "tipo": "mes_anio"
        }
      ]
    },
    "moneda": {
      "$comentario": "VERIFICAR: BCP usa 'S/' y 'US$' / 'DOLARES'.",
      "regex": "(S/\\s|US\\$|USD|DOL\\.)",
      "mapeo": {
        "S/": "PEN",
        "US$": "USD",
        "USD": "USD",
        "DOL.": "USD"
      },
      "default_moneda": "PEN"
    }
  },
  "tabla": {
    "metodo": "auto",
    "paginas": {
      "desde": 1,
      "hasta": null
    },
    "$comentario_columnas": "VERIFICAR posiciones contra PDF real. Orden típico BCP extracto: Fecha | Descripción | Cargos | Abonos | Saldo. La referencia/n° operación puede venir dentro de la descripción o como columna propia.",
    "columnas": {
      "fecha": {
        "posicion": 0.03,
        "obligatoria": true
      },
      "descripcion": {
        "posicion": 0.38,
        "obligatoria": true
      },
      "nro_operacion": {
        "posicion": 0.6,
        "obligatoria": false
      },
      "cargo": {
        "posicion": 0.74,
        "obligatoria": false
      },
      "abono": {
        "posicion": 0.86,
        "obligatoria": false
      },
      "saldo": {
        "posicion": 0.96,
        "obligatoria": true
      }
    },
    "saltos_linea_descripcion": true,
    "salto_pagina_repite_header": true,
    "ignoradas_regex": [
      "(?i)^\\s*extracto\\s*(online|consolidado)?",
      "(?i)^\\s*estado\\s*(de\\s*)?cuenta",
      "(?i)^\\s*(saldo\\s*anterior|son\\s*[0-9])",
      "(?i)^\\s*total",
      "(?i)^\\s*p[aá]gina\\s+\\d+(\\s+de\\s+\\d+)?",
      "(?i)^\\s*(bcp|banco\\s+de\\s+cr[eé]dito)",
      "(?i)^(cargos|abonos|saldo)\\s*$",
      "(?i)c[oó]digo\\s+de\\s+verificaci[oó]n"
    ],
    "formato_fecha": {
      "$comentario": "VERIFICAR: BCP usa dd/mm/yyyy.",
      "aceptados": [
        "%d/%m/%Y",
        "%d/%m/%y",
        "%Y-%m-%d"
      ],
      "ano_base_yy": 2000
    },
    "formato_numeros": {
      "esperado": "peruano"
    }
  },
  "validacion_saldo": {
    "activo": true,
    "orden_espera": "primera_abono_luego_cargo",
    "$comentario_orden": "VERIFICAR contra PDF real.",
    "permitir_iniciar_desde_saldo_impreso": true
  }
}