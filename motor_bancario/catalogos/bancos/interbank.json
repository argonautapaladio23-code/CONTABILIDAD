{
  "banco": "Interbank",
  "codigo": "INTERBANK",
  "activado": true,
  "identificacion": {
    "$comentario": "VERIFICAR contra PDF real de Interbank. Patrones típicos: 'Interbank', 'IN', 'Cuenta N°'.",
    "patrones_detect": [
      "(?i)interbank"
    ],
    "cuenta": {
      "$comentario": "VERIFICAR: Interbank imprime 'CUENTA N°' con formato 200-XXXXXX-0-XXX / 100-... según moneda (200 soles, 100 dólares aprox.). Confirmar.",
      "regex": "cuenta[^0-9]{0,45}([0-9][0-9 .\\-]{6,20}[0-9])",
      "grupo": 1
    },
    "cci": {
      "regex": "(?:cci)\\s*[:.]?\\s*([0-9]{4}[\\s-]?[0-9]{4}[\\s-]?[0-9]{6}[\\s-]?[0-9])",
      "grupo": 1,
      "opcional": true
    },
    "periodo": {
      "$comentario": "VERIFICAR: Interbank suele usar 'DEL 01/07/2026 AL 31/07/2026' o 'PERIODO: JULIO 2026'.",
      "patrones": [
        {
          "regex": "del\\s+([0-9]{2}/[0-9]{2}/[0-9]{4})\\s+al\\s+([0-9]{2}/[0-9]{2}/[0-9]{4})",
          "tipo": "rango_fecha"
        },
        {
          "regex": "(?:per[ií]odo|mes)\\s*[:.]?\\s*([0-9]{1,2}|enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)[^0-9a-zñ]+(20[0-9]{2})",
          "tipo": "mes_anio"
        }
      ]
    },
    "moneda": {
      "$comentario": "VERIFICAR: Interbank usa 'S/' y 'US$' / 'USD'.",
      "regex": "(S/\\s|US\\$|USD)",
      "mapeo": {
        "S/": "PEN",
        "US$": "USD",
        "USD": "USD"
      },
      "default_moneda": "PEN"
    }
  },
  "tabla": {
    "metodo": "auto",
    "paginas": {
      "desde": 1,
      "hasta": null
    },
    "$comentario_columnas": "VERIFICAR posiciones contra PDF real. Orden típico Interbank: Fecha | Descripción | Recargos/Cargos | Abonos | Saldo.",
    "columnas": {
      "fecha": {
        "posicion": 0.03,
        "obligatoria": true
      },
      "descripcion": {
        "posicion": 0.36,
        "obligatoria": true
      },
      "nro_operacion": {
        "posicion": 0.58,
        "obligatoria": false
      },
      "cargo": {
        "posicion": 0.74,
        "obligatoria": false
      },
      "abono": {
        "posicion": 0.86,
        "obligatoria": false
      },
      "saldo": {
        "posicion": 0.96,
        "obligatoria": true
      }
    },
    "saltos_linea_descripcion": true,
    "salto_pagina_repite_header": true,
    "ignoradas_regex": [
      "(?i)^\\s*estado\\s*de\\s*cuenta",
      "(?i)^\\s*(saldo\\s*anterior|son\\s*[0-9])",
      "(?i)^\\s*total",
      "(?i)^\\s*p[aá]gina\\s+\\d+(\\s+de\\s+\\d+)?",
      "(?i)^\\s*interbank\\b",
      "(?i)^(cargos|abonos|recargos|saldo)\\s*$",
      "(?i)c[oó]digo\\s*(de\\s*)?verificador"
    ],
    "formato_fecha": {
      "$comentario": "VERIFICAR: Interbank usa dd/mm/yyyy.",
      "aceptados": [
        "%d/%m/%Y",
        "%d/%m/%y",
        "%Y-%m-%d"
      ],
      "ano_base_yy": 2000
    },
    "formato_numeros": {
      "esperado": "peruano"
    }
  },
  "validacion_saldo": {
    "activo": true,
    "orden_espera": "primera_abono_luego_cargo",
    "$comentario_orden": "VERIFICAR contra PDF real.",
    "permitir_iniciar_desde_saldo_impreso": true
  }
}